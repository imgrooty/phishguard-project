{
  "name": "phishguard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "_comment": "Extension build scripts",
    "build-extension": "./build-extension.sh",
    "build-extension-dev": "cd extension && sed -i.bak \"s/const CURRENT_ENV = '.*';/const CURRENT_ENV = 'development';/\" config.js && zip -r ../public/phishguard-extension-dev.zip . -x '*.git*' -x 'README.md' -x '*.bak' && rm -f config.js.bak",
    "build-extension-prod": "cd extension && sed -i.bak \"s/const CURRENT_ENV = '.*';/const CURRENT_ENV = 'production';/\" config.js && zip -r ../public/phishguard-extension-prod.zip . -x '*.git*' -x 'README.md' -x '*.bak' && rm -f config.js.bak"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.33.1",
    "@react-email/components": "^0.5.5",
    "@react-email/render": "^1.3.1",
    "@supabase/supabase-js": "^2.56.0",
    "bcryptjs": "^3.0.2",
    "framer-motion": "^12.27.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.541.0",
    "mongoose": "^8.19.0",
    "next": "15.5.9",
    "next-auth": "^4.24.11",
    "nodemailer": "^6.10.1",
    "postcss": "^8.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-email": "^4.2.11",
    "react-icons": "^5.5.0",
    "resend": "^6.1.0",
    "swr": "^2.3.6",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/next-auth": "^3.15.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.9",
    "tailwindcss": "^4.1.12",
    "typescript": "^5"
  }
}
